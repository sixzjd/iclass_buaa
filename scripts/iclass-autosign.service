[Unit]
Description=iClass 自动签到（BUAA 北航）
Documentation=https://github.com/zeroduhyy/iclass_buaa
After=network-online.target
Wants=network-online.target
# 配置写错时不要无限重启刷日志
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@INSTALL_DIR@
Environment=NODE_ENV=production
Environment=NO_COLOR=1
Environment=ICLASS_CONFIG=@CONFIG_FILE@
ExecStart=@NODE_BIN@ @INSTALL_DIR@/autosign.js
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iclass-autosign

[Install]
WantedBy=multi-user.target
